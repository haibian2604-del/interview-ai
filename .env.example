# Supabase（Supabase Dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 系统级默认 LLM（任何 OpenAI 兼容端点）：用户未在设置页配置时逐字段回落使用
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
# 可选：评估/报告用强模型，不配则用 LLM_CHAT_MODEL
LLM_EVAL_MODEL=gpt-4o

# 用户级 LLM 设置的加密密钥（任意高熵随机串；丢失将导致所有已存用户 key 无法解密，自动回落系统默认）
SETTINGS_SECRET=

# 语音识别（可选）：用户级 BYOK 配置的回落；不配则逐字段回落用户的 LLM 端点/密钥
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
